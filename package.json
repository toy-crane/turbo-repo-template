{
  "name": "turbo-repo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "turbo run fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "ultracite": "7.10.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.6"
    }
  }
}
