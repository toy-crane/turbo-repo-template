{
  "name": "turbo-repo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent-device": "agent-device",
    "agent-device:doctor": "agent-device doctor",
    "build": "turbo run build",
    "check": "ultracite check scripts && turbo run check",
    "check-types": "tsc --noEmit && turbo run check-types",
    "db:diff": "supabase db diff",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "dev": "turbo run dev",
    "fix": "ultracite fix scripts && turbo run fix",
    "setup": "bun scripts/setup/cli.ts",
    "test": "bun test scripts && turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "agent-device": "0.20.5",
    "supabase": "2.113.0",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "ultracite": "7.10.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.6"
    }
  }
}
