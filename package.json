{
  "name": "turbo-repo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "agent-device": "agent-device",
    "agent-device:doctor": "agent-device doctor",
    "auth:otp": "bun scripts/auth/read-local-email-otp.ts",
    "build": "turbo run build",
    "check": "turbo run check",
    "check-types": "turbo run check-types",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint --level warning --schema public",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > \"${TMPDIR:-/tmp}/database.types.ts\" && mv \"${TMPDIR:-/tmp}/database.types.ts\" packages/supabase/src/database.types.ts",
    "dev": "bun scripts/dev/cli.ts",
    "dev:remove": "bun scripts/dev/cli.ts remove",
    "dev:status": "bun scripts/dev/cli.ts status",
    "dev:stop": "bun scripts/dev/cli.ts stop",
    "fix": "turbo run fix",
    "postinstall": "bun scripts/setup/vendor-markdown-assets.ts",
    "setup": "bun scripts/setup/cli.ts",
    "test": "turbo run test",
    "test:integration": "bun run --cwd scripts test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "agent-device": "0.20.5",
    "supabase": "2.113.0",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "ultracite": "7.10.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.6"
    }
  }
}
