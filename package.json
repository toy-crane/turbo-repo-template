{
  "name": "turbo-repo-template",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent-device": "agent-device",
    "agent-device:doctor": "agent-device doctor",
    "build": "turbo run build",
    "check": "turbo run check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "turbo run fix",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "agent-device": "0.20.5",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "ultracite": "7.10.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.6"
    }
  },
  "patchedDependencies": {
    "expo-glass-tabs@0.1.1": "patches/expo-glass-tabs@0.1.1.patch",
    "expo-symbols@57.0.2": "patches/expo-symbols@57.0.2.patch",
    "@expo/ui@57.0.9": "patches/@expo%2Fui@57.0.9.patch"
  }
