{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // app.config.ts is loaded by the Expo CLI, not bundled by Metro, and its
    // loader only resolves a relative import when the extension is explicit.
    "allowImportingTsExtensions": true,
    // Every import that crosses one of the four src areas uses this. Metro
    // reads it directly, so nothing else has to be configured for the app;
    // Jest maps the same prefix in jest.config.mjs.
    "paths": {
      "@env": ["./env.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
