{
  "name": "@repo/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "bun run build:ios && bun run build:android",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "check": "bun run check:expo && ultracite check .",
    "check:expo": "EXPO_NO_DOTENV=1 MOBILE_EXPO_STATIC_CONFIG=1 CI=1 expo install --check",
    "check-types": "EXPO_NO_DOTENV=1 MOBILE_EXPO_STATIC_CONFIG=1 expo customize tsconfig.json && tsc --noEmit",
    "dev": "expo start --dev-client",
    "fix": "ultracite fix .",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.61",
    "@babel/runtime": "7.29.7",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.11",
    "@legendapp/list": "3.3.5",
    "@noble/ciphers": "2.3.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@repo/supabase": "workspace:*",
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-query": "5.101.4",
    "ai": "7.0.58",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "heroui-native": "1.0.8",
    "lucide-react-native": "1.31.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.3",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.29.7",
    "@jest/globals": "29.7.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "57.0.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller"
      ]
    }
  }
}
