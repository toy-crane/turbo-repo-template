{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // Shared config that changes what a task should produce. Without these, a
  // lint or compiler setting can change while turbo replays cached passes.
  "globalDependencies": ["biome.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "@repo/mobile#check": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    },
    // The web tests read apps/mobile/app.json to catch a renamed app leaving the
    // web pages behind. That file is outside this package, so it is not in the
    // task hash and a cached pass would hide the drift the test exists to find.
    "@repo/web#test": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "@repo/mobile#check-types": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
